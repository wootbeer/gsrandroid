# Copy this file to "keystore.properties" (same folder, project root) and fill in the real
# values. keystore.properties is gitignored -- it and the .jks/.keystore file it points to must
# NEVER be committed. Losing this key means you can never publish an update that existing users
# can install over their current copy -- back it up somewhere safe outside this repo.
#
# storeFile is relative to the project root (where this file lives).
storeFile=gsr-release-key.jks
storePassword=REPLACE_ME
keyAlias=gsr
keyPassword=REPLACE_ME
